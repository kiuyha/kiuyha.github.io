---
import Footer from "../components/Footer";
import LoadingScreen from "../components/LoadingScreen";
import "../index.css";
import { getPageData } from "../lib/astro";
import Shell from "./Shell";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	initialData?: Awaited<ReturnType<typeof getPageData>>;
	hideShell?: boolean;
}

const {
	title = `${import.meta.env.PUBLIC_FULL_NAME} (${import.meta.env.PUBLIC_NICKNAME}) | ${import.meta.env.PUBLIC_TITLE}`,
	description = `This is a web for ${import.meta.env.PUBLIC_FULL_NAME} (${import.meta.env.PUBLIC_NICKNAME}) portfolio`,
	image = "/thumbnails/profile.png",
	initialData,
	hideShell = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_WEBSITE_LINK || "https://kiuyha.dev";
const githubApi = import.meta.env.PUBLIC_GITHUB_API_LINK;

const rawPathname = Astro.url.pathname.replace(/\.html$/, "");
const canonicalPath = rawPathname.endsWith("/")
	? rawPathname
	: `${rawPathname}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;

let alternateLinks: Array<{ lang: string; href: string }> = [];
if (initialData?.supportedLangs && initialData?.currentLang) {
	const pathWithoutLang = Astro.url.pathname.replace(
		new RegExp(`^/${initialData.currentLang}`),
		"",
	);
	const normalizedBasePath = pathWithoutLang.endsWith("/")
		? pathWithoutLang
		: `${pathWithoutLang}/`;

	alternateLinks = initialData.supportedLangs.map((lang) => {
		const altPath = `/${lang.code}${normalizedBasePath}`.replace(
			/\/+/g,
			"/",
		);
		return {
			lang: lang.code,
			href: new URL(altPath, siteUrl).href,
		};
	});

	const defaultLang =
		initialData.supportedLangs.find((l) => l.code === "en") ||
		initialData.supportedLangs[0];
	const defaultPath = `/${defaultLang.code}${normalizedBasePath}`.replace(
		/\/+/g,
		"/",
	);
	alternateLinks.push({
		lang: "x-default",
		href: new URL(defaultPath, siteUrl).href,
	});
}
---

<!doctype html>
<html lang={initialData?.currentLang || "en"} class="no-js">
	<head>
		<script is:inline>
			document.documentElement.classList.remove('no-js');
			document.documentElement.classList.add('js');
			// Re-apply after every View Transitions swap (registers only once)
			if (!window.__jsClassSetup) {
				window.__jsClassSetup = true;
				document.addEventListener('astro:after-swap', () => {
					document.documentElement.classList.remove('no-js');
					document.documentElement.classList.add('js');
				});
			}
		</script>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="ie=edge" />
		<link rel="sitemap" type="application/xml" title="Sitemap" href={new URL("sitemap.xml", siteUrl)} />

		<link rel="canonical" href={canonicalUrl} />
		{
			alternateLinks.map((link) => (
				<link rel="alternate" hreflang={link.lang} href={link.href} />
			))
		}

		<title>{title}</title>

		<meta name="author" content="Kiuyha" />
		<link rel="author" href="https://github.com/kiuyha" />
		<meta name="description" content={description} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="profile" />
		<meta property="og:image" content={new URL(image, siteUrl)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<link rel="preconnect" href="https://docs.google.com" crossorigin />
		<link rel="preconnect" href={githubApi} crossorigin />
		<link rel="preconnect" href="https://api.rss2json.com" crossorigin />

		<ClientRouter />
		<noscript>
			<style>
				/* Hide loading screen immediately if JavaScript is disabled */
				#loading-screen,
				astro-island[component-url*="LoadingScreen"] {
					display: none !important;
				}

				/* Reset any inline opacity/transform styles applied during SSR by framer-motion */
				body * {
					opacity: 1 !important;
					transform: none !important;
					filter: none !important;
					visibility: visible !important;
				}
			</style>
		</noscript>
	</head>
	<body class="bg-primary text-black dark:text-white relative min-h-screen">
		<LoadingScreen
			client:load
			transition:persist
			translations={initialData?.translations?.common}
		/>

		{
			initialData ? (
				hideShell ? (
					<main class="min-h-screen">
						<slot />
					</main>
				) : (
					<>
						<Shell
							client:load
							initialData={initialData}
							transition:persist
						/>
						<main class="pt-25 pb-8 px-3 md:px-8">
							<slot />
						</main>
						<Footer
							client:visible
							translations={initialData.translations}
						/>
					</>
				)
			) : (
				<slot />
			)
		}
	</body>
</html>
