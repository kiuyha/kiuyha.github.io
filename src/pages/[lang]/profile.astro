---
import MainLayout from "../../layouts/MainLayout.astro";
import ProfileView from "../../views/Profile";
import { getSharedStaticPaths, getPageData } from "../../lib/astro";

export const getStaticPaths = getSharedStaticPaths;

const { lang } = Astro.params;
const { langInfo } = Astro.props;
const data = await getPageData(lang, langInfo);

const title = `${import.meta.env.PUBLIC_FULL_NAME} | ${data.translations?.navbar?.profile || "Profile"}`;
const description = `This is profile and work experience for ${import.meta.env.PUBLIC_FULL_NAME} (${import.meta.env.PUBLIC_NICKNAME})`;
---

<MainLayout
	initialData={data}
	title={title}
	image="/banners/profile.avif"
	description={description}
>
	<ProfileView client:load data={data} />
</MainLayout>
