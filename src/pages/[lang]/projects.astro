---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectsView from "../../views/Projects";
import { getSharedStaticPaths, getPageData } from "../../lib/astro";

export const getStaticPaths = getSharedStaticPaths;

const { lang } = Astro.params;
const { langInfo } = Astro.props;
const data = await getPageData(lang, langInfo);

const title = `${import.meta.env.PUBLIC_FULL_NAME} | ${data.translations?.navbar?.projects || "Projects"}`;
const description = `This is page for ${import.meta.env.PUBLIC_FULL_NAME} (${import.meta.env.PUBLIC_NICKNAME}) projects`;
---

<MainLayout
	initialData={data}
	title={title}
	image="/placeholders/project.avif"
	description={description}
>
	<ProjectsView client:load data={data} />
</MainLayout>
